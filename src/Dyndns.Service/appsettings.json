{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dyndns-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 1048576,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },
  "Dynv6": {
    "ZoneName": "",
    "Key": "",
    "ForceUpdate": false,
    "ScheduledEvery": "00:05:00",
    "PublicIpUrl": "https://api.ipify.org?format=json",
    "DyndnsApiUrl": "https://dynv6.com/api/v2/"
  },
  "WebUi": {
    "Url": "http://localhost:5050"
  },
  "Notifications": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "ToAddress": "",
    "Username": "",
    "Password": "",
    "SubjectPrefix": "Dynv6 automaton"
  }
}
